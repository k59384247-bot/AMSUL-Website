# Build-time switch. Change this and rebuild/redeploy to switch sources.
NEXT_PUBLIC_WEBSITE_DATA_SOURCE=local

# Pages Function runtime settings, used only by API mode. No Firebase admin credentials.
AMSUL_API_BASE_URL=https://us-central1-mt-cms-dashboard-staging.cloudfunctions.net/api
AMSUL_TENANT_ID=amsul
# Set a long random secret in Cloudflare Pages (never NEXT_PUBLIC_).
AMSUL_MEDIA_SIGNING_SECRET=
# Comma-separated HTTPS origins if dashboard assets use additional public storage hosts.
AMSUL_MEDIA_ORIGINS=https://firebasestorage.googleapis.com,https://storage.googleapis.com

# Signed dashboard notifications (server-side). Match the Firebase secret below.
AMSUL_CACHE_WEBHOOK_SECRET=
# AMSUL_CACHE_DB is a Cloudflare D1 binding, not a text environment variable.
# Initialize it using cloudflare/cache-schema.sql. The dev server uses local SQLite.
